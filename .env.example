# ==============================================================================
# Expense Tracker Frontend Environment Configuration (Expo)
# ==============================================================================
# NOTE: All variables prefixed with EXPO_PUBLIC_ are bundled into the client app.
# NEVER store private secrets, database credentials, or JWT secrets in frontend variables.

# API Base URL:
# - For local development on PC/Web: http://localhost:5000/api
# - For Android emulator on PC: http://10.0.2.2:5000/api
# - For physical Android phone testing on Wi-Fi: http://YOUR-PC-LAN-IP:5000/api
EXPO_PUBLIC_API_URL=http://YOUR-PC-LAN-IP:5000/api

# Mock Mode Toggle:
# Set to 'false' to communicate with the real backend API instead of local mock services.
EXPO_PUBLIC_USE_MOCK_API=false
